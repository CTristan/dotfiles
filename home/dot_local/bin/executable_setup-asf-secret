#!/bin/zsh
# Store the ASF backup passphrase without exposing it in process arguments.
set -euo pipefail

if [[ -n "${ASF_SECRET_TOOLS_PATH:-}" ]]; then
  export PATH="${ASF_SECRET_TOOLS_PATH}:${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"
fi

SERVICE=asf-backup
NOTE_NAME='dotfiles: ASF backup'
FIELD_NAME=passphrase
ACCOUNT="${USER:-$(id -un)}"
WRITER_BIN="${ASF_KEYCHAIN_WRITER:-$HOME/.local/bin/asf-keychain-write}"
WRITER_SOURCE="${ASF_KEYCHAIN_WRITER_SOURCE:-$HOME/.local/share/asf-backup/asf-keychain-write.c}"

usage() {
  print -u2 'Usage: setup-asf-secret [--check | --no-bitwarden]'
}

mode=setup
case "$#" in
  0) ;;
  1)
    case "$1" in
      --check) mode=check ;;
      --no-bitwarden) mode=manual ;;
      *) usage; exit 1 ;;
    esac
    ;;
  *) usage; exit 1 ;;
esac

# Keep inherited session keys in shell memory and pass them only to Bitwarden.
typeset -g supplied_session="${BW_SESSION:-}"
typeset -g session="$supplied_session" session_owned=0
unset BW_SESSION
if [[ "$mode" == check || "$mode" == manual ]]; then
  supplied_session=''
  session=''
fi

keychain_has_item() {
  local result
  if command security find-generic-password -s "$SERVICE" >/dev/null 2>&1; then
    return 0
  else
    result=$?
  fi

  if [[ "$result" -eq 44 ]]; then
    return 1
  fi
  return 2
}

report_lookup_error() {
  print -u2 "Could not check the '$SERVICE' Keychain item."
  return 1
}

if [[ "$mode" == check ]]; then
  if keychain_has_item; then
    print 'ASF backup passphrase is ready.'
    exit 0
  else
    lookup_status=$?
  fi
  if [[ "$lookup_status" -eq 1 ]]; then
    print -u2 'ASF backup passphrase is missing; run setup-asf-secret to add it.'
    exit 2
  fi
  report_lookup_error
  exit 1
fi

cleanup() {
  local exit_status=$?
  trap - EXIT INT TERM HUP
  if [[ "$session_owned" -eq 1 && -n "$session" ]]; then
    BW_SESSION="$session" command bw lock >/dev/null 2>&1 || true
  fi
  session=''
  supplied_session=''
  exit "$exit_status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

pending() {
  print -u2 "$1"
  return 2
}

ensure_writer() {
  local compiler temporary

  if [[ -n "${ASF_KEYCHAIN_WRITER:-}" ]]; then
    [[ -x "$WRITER_BIN" ]] || {
      print -u2 'The configured Keychain writer is not executable.'
      return 1
    }
    return 0
  fi

  if [[ -x "$WRITER_BIN" && -f "$WRITER_SOURCE" && ! "$WRITER_SOURCE" -nt "$WRITER_BIN" ]]; then
    return 0
  fi
  [[ -f "$WRITER_SOURCE" ]] || {
    print -u2 "Keychain writer source is missing: $WRITER_SOURCE"
    return 1
  }
  compiler="$(command -v clang 2>/dev/null || true)"
  [[ -n "$compiler" ]] || {
    print -u2 'clang is required to build the Keychain writer; install the Xcode Command Line Tools.'
    return 1
  }

  command mkdir -p "${WRITER_BIN:h}"
  temporary="${WRITER_BIN}.tmp.$$"
  command rm -f "$temporary"
  if ! "$compiler" -O2 -Wall -Wextra -Wno-deprecated-declarations \
      -o "$temporary" "$WRITER_SOURCE" -framework Security -framework CoreFoundation; then
    command rm -f "$temporary"
    print -u2 'Could not compile the Keychain writer.'
    return 1
  fi
  command chmod 700 "$temporary"
  command mv -f "$temporary" "$WRITER_BIN"
}

show_ready() {
  print 'ASF backup passphrase is ready.'
}

write_manual() {
  if [[ ! -t 0 || ! -r /dev/tty ]]; then
    pending 'No terminal is available; run setup-asf-secret from a terminal to enter the passphrase.'
    return $?
  fi
  ensure_writer || return 1
  print -u2 'Enter the ASF backup passphrase. Input is hidden.'
  if USER="$ACCOUNT" "$WRITER_BIN" </dev/tty; then
    if keychain_has_item; then
      show_ready
      return 0
    else
      lookup_status=$?
    fi
    if [[ "$lookup_status" -eq 1 ]]; then
      print -u2 'The Keychain writer did not create the ASF backup item.'
      return 1
    fi
    report_lookup_error
    return 1
  fi
  print -u2 'The ASF backup passphrase was not added to Keychain.'
  return 1
}

bw_call() {
  if [[ -n "$session" ]]; then
    BW_SESSION="$session" command bw "$@"
  else
    command bw "$@"
  fi
}

ensure_bw() {
  local brew_path
  if command -v bw >/dev/null 2>&1; then
    return 0
  fi
  brew_path="$(command -v brew 2>/dev/null || true)"
  [[ -n "$brew_path" ]] || {
    print -u2 'Bitwarden CLI is missing and Homebrew is unavailable.'
    return 1
  }
  print 'Installing Bitwarden CLI for this selected import.'
  "$brew_path" install bitwarden-cli || return 1
  command -v bw >/dev/null 2>&1 || {
    print -u2 'Bitwarden CLI was not found after installation.'
    return 1
  }
}

read_bw_status() {
  local status_json
  if ! status_json="$(bw_call status 2>/dev/null)"; then
    return 1
  fi
  print -r -- "$status_json" | command jq -er '.status | select(type == "string")' 2>/dev/null
}

prepare_bw_session() {
  local status_value

  if [[ -n "$supplied_session" ]]; then
    status_value="$(read_bw_status)" || {
      pending 'The supplied Bitwarden session is not active; unlock Bitwarden and retry.'
      return $?
    }
    [[ "$status_value" == unlocked ]] || {
      pending 'The supplied Bitwarden session is not unlocked; unlock Bitwarden and retry.'
      return $?
    }
    return 0
  fi

  if [[ ! -t 0 || ! -r /dev/tty ]]; then
    pending 'No active BW_SESSION is available; run setup-asf-secret from a terminal or provide an active BW_SESSION.'
    return $?
  fi

  status_value="$(read_bw_status)" || {
    print -u2 'Could not read Bitwarden CLI status.'
    return 1
  }
  case "$status_value" in
    unauthenticated)
      if ! session="$(command bw login --raw)" || [[ -z "$session" ]]; then
        session=''
        print -u2 'Bitwarden login did not provide a session.'
        return 1
      fi
      session_owned=1
      ;;
    locked|unlocked)
      if ! session="$(command bw unlock --raw)" || [[ -z "$session" ]]; then
        session=''
        print -u2 'Bitwarden unlock did not provide a session.'
        return 1
      fi
      session_owned=1
      ;;
    *)
      print -u2 'Bitwarden returned an unrecognized vault status.'
      return 1
      ;;
  esac

  status_value="$(read_bw_status)" || {
    print -u2 'The new Bitwarden session could not be checked.'
    return 1
  }
  [[ "$status_value" == unlocked ]] || {
    print -u2 'The new Bitwarden session is not unlocked.'
    return 1
  }
}

import_from_bw() {
  local item_id item_json passphrase_encoded pipeline_status

  command -v jq >/dev/null 2>&1 || {
    print -u2 'jq is required for the Bitwarden import.'
    return 1
  }
  ensure_bw || return 1
  prepare_bw_session || return $?
  if ! bw_call sync >/dev/null 2>&1; then
    pending 'Bitwarden could not sync; check network connectivity and vault status, then retry.'
    return $?
  fi

  if ! item_id="$(bw_call list items --search "$NOTE_NAME" 2>/dev/null \
      | command jq -er --arg note "$NOTE_NAME" \
        '[.[]? | select(.name == $note and .type == 2)] | if length == 1 and (.[0].id | type == "string" and length > 0) then .[0].id else error("expected one exact Secure Note") end' 2>/dev/null)"; then
    print -u2 "Bitwarden must contain exactly one Secure Note named '$NOTE_NAME'."
    return 1
  fi

  if ! item_json="$(bw_call get item "$item_id" 2>/dev/null)"; then
    item_json=''
    print -u2 'Bitwarden could not retrieve the selected Secure Note.'
    return 1
  fi

  if ! passphrase_encoded="$(print -rn -- "$item_json" \
      | command jq -erj --arg field "$FIELD_NAME" --arg note "$NOTE_NAME" --arg id "$item_id" \
        'select(.id == $id and .name == $note and .type == 2) | [.fields[]? | select(.name == $field and .type == 1)] | if length == 1 and ((.[0].value | type) == "string" and (.[0].value | length) > 0) then (.[0].value | @base64) else error("expected one non-empty hidden field on the selected note") end' 2>/dev/null)"; then
    item_json=''
    print -u2 'Bitwarden data was missing, ambiguous, or empty.'
    return 1
  fi

  ensure_writer || return 1
  if print -rn -- "$passphrase_encoded" | command base64 -D | USER="$ACCOUNT" "$WRITER_BIN"; then
    pipeline_status=0
  else
    pipeline_status=$?
  fi
  passphrase_encoded=''
  item_json=''

  if [[ "$pipeline_status" -eq 3 ]]; then
    if keychain_has_item; then
      show_ready
      return 0
    fi
    print -u2 'Another Keychain item prevented the add; no credential was overwritten.'
    return 1
  fi
  if [[ "$pipeline_status" -ne 0 ]]; then
    print -u2 'Bitwarden data was missing, ambiguous, empty, or could not be stored.'
    return 1
  fi

  if keychain_has_item; then
    show_ready
    return 0
  fi
  print -u2 'The Keychain writer did not create the ASF backup item.'
  return 1
}

if keychain_has_item; then
  show_ready
  exit 0
else
  lookup_status=$?
fi
if [[ "$lookup_status" -eq 2 ]]; then
  report_lookup_error
  exit 1
fi

if [[ "$mode" == manual ]]; then
  if write_manual; then
    exit 0
  else
    lookup_status=$?
    exit "$lookup_status"
  fi
fi

if [[ ! -t 0 || ! -r /dev/tty ]]; then
  if [[ -n "$supplied_session" ]]; then
    ensure_bw || exit 1
    if import_from_bw; then
      exit 0
    else
      lookup_status=$?
      exit "$lookup_status"
    fi
  fi
  pending 'No terminal is available; run setup-asf-secret to choose a passphrase source.'
  exit $?
fi

print -u2 'No ASF backup passphrase is stored.'
printf 'Enter it manually [m] or import from Bitwarden [b]? [m]: ' >/dev/tty
choice=''
IFS= read -r choice </dev/tty || choice=''
case "$choice" in
  b|B)
    if import_from_bw; then
      exit 0
    else
      lookup_status=$?
      exit "$lookup_status"
    fi
    ;;
  ''|m|M)
    if write_manual; then
      exit 0
    else
      lookup_status=$?
      exit "$lookup_status"
    fi
    ;;
  *)
    print -u2 'Choose m or b.'
    exit 2
    ;;
esac
